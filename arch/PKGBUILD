# Maintainer: James Oakey

pkgname=conky-gruvbox-dark-git
_pkgname=conky-gruvbox-dark
pkgver=r21.b218dd2
pkgrel=1
pkgdesc="Gruvbox-dark conky widget stack: rounded cards for CPU, memory, weather, fuel prices, now playing, batteries and countdowns"
arch=('any')
url="https://github.com/joakee/conkyconf"
license=('LicenseRef-unknown')
depends=(
  'conky>=1.25'
  'imagemagick'
  'maple-mono-nf-cn'
  'python'
  'python-xlib'
  'systemd'
  'util-linux'
)
makedepends=('git')
optdepends=(
  'picom: compositor for the translucent rounded cards and the focus fade'
  'wayfire: Wayland session support (wayland/; also needs conky>=1.25.4 and the layer-output plugin, see wayland/README.md)'
  'podctl: AirPods battery levels on the batteries card'
  'libimobiledevice: iPhone battery level on the batteries card'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
install="$_pkgname.install"
source=("conkyconf::git+$url.git"
        "$_pkgname")
sha256sums=('SKIP'
            '0ef61a24c5b3beaf903d460a8af6008a45e599773727f0cfb0c6f2ba01e617e1')

pkgver() {
  cd conkyconf
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd conkyconf

  # The stack exactly as it lives in ~/.config/conky/gruvbox-dark, which is
  # where `conky-gruvbox-dark install` copies it for each user. wayland/ is
  # the Wayland mode of the same stack. attic/ is earlier versions kept for
  # reference, and arch/ is this packaging.
  local share="$pkgdir/usr/share/$_pkgname"
  install -d "$share"
  cp -r --no-preserve=ownership start.sh widget-common.lua bin lua widgets wayland "$share/"
  find "$share" -name __pycache__ -prune -exec rm -rf {} +

  install -Dm755 "$srcdir/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
}
