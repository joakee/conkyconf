#!/usr/bin/env python3
"""Set up and run the gruvbox-dark conky widget stack for the current user.

The package installs the stack to /usr/share/conky-gruvbox-dark, but it runs
from ~/.config/conky/gruvbox-dark: every widget finds the others by that path,
and it is where local tweaks belong (another CPU sensor, M.OUTPUT for your
monitor, a widget taken out). This copies it there and keeps the copy up to
date with the package the way pacman treats /etc: a file you have not edited
is updated in place, one you have edited is left alone and the new version is
written beside it as <file>.pacnew. A file you deleted stays deleted.

  conky-gruvbox-dark install [--no-start]
        copy the stack in, start it at login, and start it now
  conky-gruvbox-dark start      bring the copy up to date and (re)start it
  conky-gruvbox-dark update     only bring the copy up to date
  conky-gruvbox-dark stop       stop the widgets
  conky-gruvbox-dark uninstall  stop, and remove the login entry (your copy
                                in ~/.config/conky/gruvbox-dark is kept)
"""

import hashlib
import json
import os
import shutil
import signal
import subprocess
import sys

NAME = "conky-gruvbox-dark"
SHARE = os.environ.get("CONKY_GRUVBOX_SHARE", "/usr/share/" + NAME)
# Not $XDG_CONFIG_HOME: the widgets hard-code this path to reach each other.
CONFIG = os.path.expanduser("~/.config/conky/gruvbox-dark")
MANIFEST = os.path.join(CONFIG, ".package-manifest")
AUTOSTART = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "autostart", NAME + ".desktop")

DESKTOP = """\
[Desktop Entry]
Type=Application
Name=Conky (gruvbox-dark)
Comment=System monitor themed to match gruvbox-dark
TryExec=/usr/bin/{name}
Exec=/usr/bin/{name} start
Icon=utilities-system-monitor
Terminal=false
StartupNotify=false
X-GNOME-Autostart-enabled=true
""".format(name=NAME)


def say(msg):
    print("%s: %s" % (NAME, msg))


def digest(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for block in iter(lambda: fh.read(1 << 16), b""):
            h.update(block)
    return h.hexdigest()


def package_files():
    """relative path -> sha256 for every file the package ships."""
    out = {}
    for top, dirs, files in os.walk(SHARE):
        dirs[:] = [d for d in dirs if d != "__pycache__"]
        for f in files:
            path = os.path.join(top, f)
            out[os.path.relpath(path, SHARE)] = digest(path)
    return out


def copy(src, dst):
    """Copy with mode and mtime, replacing dst in one step."""
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = dst + ".tmp-" + NAME
    shutil.copy2(src, tmp)
    os.replace(tmp, dst)


def update(report=True):
    """Bring CONFIG up to date with SHARE, saying what changed unless
    `report` is false. Returns False if there is nothing installed to update
    from."""
    if not os.path.isdir(SHARE):
        say("%s is missing -- is the package installed?" % SHARE)
        return False
    try:
        with open(MANIFEST) as fh:
            old = json.load(fh)["files"]
    except (OSError, ValueError, KeyError):
        # Never set up by this command: either a fresh install, or a copy put
        # there by hand (a git clone, say). Adopt it -- with nothing known
        # about what it was copied from, every file that differs counts as
        # edited and is kept, so nothing of yours is overwritten.
        old = {}
    new = package_files()
    done = {"added": [], "updated": [], "removed": [], "pacnew": []}

    for rel, sha in sorted(new.items()):
        src, dst = os.path.join(SHARE, rel), os.path.join(CONFIG, rel)
        if not os.path.lexists(dst):
            if rel not in old:              # new in this version
                copy(src, dst)
                done["added"].append(rel)
            continue                        # else deleted by you; leave it so
        cur = digest(dst)
        if cur == sha:
            continue
        if old.get(rel) == cur:             # untouched since we put it there
            copy(src, dst)
            done["updated"].append(rel)
        elif old.get(rel) != sha:           # edited, and the package changed it
            copy(src, dst + ".pacnew")
            done["pacnew"].append(rel)

    for rel, sha in sorted(old.items()):
        dst = os.path.join(CONFIG, rel)
        if rel not in new and os.path.isfile(dst) and digest(dst) == sha:
            os.remove(dst)                  # dropped upstream, never edited
            done["removed"].append(rel)

    os.makedirs(CONFIG, exist_ok=True)
    with open(MANIFEST + ".tmp", "w") as fh:
        json.dump({"files": new}, fh, indent=1, sort_keys=True)
    os.replace(MANIFEST + ".tmp", MANIFEST)

    for what, files in done.items():
        for rel in files if report or what == "pacnew" else ():
            if what == "pacnew":
                say("kept your %s; the new version is %s.pacnew"
                    % (rel, rel))
            else:
                say("%s %s" % (what, rel))
    return True


def ours():
    """pids of this stack's processes: the conky cards and the two watchers."""
    pids = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == os.getpid():
            continue
        try:
            with open("/proc/%s/cmdline" % entry, "rb") as fh:
                argv = fh.read().decode(errors="replace").split("\0")
        except OSError:
            continue
        if any(a.startswith(CONFIG + "/") for a in argv):
            pids.append(int(entry))
    return pids


def stop():
    for pid in ours():
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass


def start():
    if not update():
        return 1
    script = os.path.join(CONFIG, "start.sh")
    if not os.access(script, os.X_OK):
        say("%s is missing or not executable" % script)
        return 1
    # start.sh restarts conky itself, but the watchers hold a lock and would
    # carry on with the old code after an update, so take them down too.
    stop()
    # Detached, so the widgets outlive the terminal this was run from.
    subprocess.Popen([script], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)
    return 0


def install(args):
    if os.geteuid() == 0:
        say("run this as the user the widgets are for, not as root")
        return 1
    fresh = not os.path.exists(CONFIG)
    if not update(report=not fresh):
        return 1
    say(("installed to %s" if fresh else "brought %s up to date") % CONFIG)
    os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
    with open(AUTOSTART, "w") as fh:
        fh.write(DESKTOP)
    say("starts at login via %s" % AUTOSTART)
    if "--no-start" in args:
        return 0
    say("starting (the stack waits a few seconds for the desktop to settle)")
    return start()


def uninstall():
    stop()
    try:
        os.remove(AUTOSTART)
        say("removed %s" % AUTOSTART)
    except FileNotFoundError:
        pass
    say("your copy is still in %s; delete it to remove it completely"
        % CONFIG)
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "start"
    if cmd == "install":
        return install(argv[2:])
    if cmd == "start":
        return start()
    if cmd == "update":
        return 0 if update() else 1
    if cmd == "stop":
        stop()
        return 0
    if cmd == "uninstall":
        return uninstall()
    print(__doc__.strip())
    return 0 if cmd in ("-h", "--help", "help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
